{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/download", "destination": "/api/download" }
  ],
  "headers": [
    { "source": "/download/(.*).dmg", "headers": [{ "key": "Content-Type", "value": "application/x-apple-diskimage" }, { "key": "Content-Disposition", "value": "attachment" }] },
    { "source": "/stats", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Referrer-Policy", "value": "no-referrer" }] },
    { "source": "/api/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
